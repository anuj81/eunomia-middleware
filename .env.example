# Copy this file to .env and fill in real values.
# .env is gitignored — never commit secrets.

# OpenMetadata REST credentials (used when openmetadata.mock=false)
OPENMETADATA_PASSWORD=admin

# MySQL password for the api_user
DB_PASSWORD=newvibes

# Google Gemini API key
GEMINI_API_KEY=

# Eunomia RAG service API key (used when rag.mock=false in Phase C)
RAG_API_KEY=

# Optional: override config file location (defaults to config/eunomia.yaml)
# EUNOMIA_CONFIG=config/eunomia.local.yaml

# Generic override pattern — works for ANY field via pydantic-settings:
#   EUNOMIA_<SECTION>__<FIELD>=value
# Example:
#   EUNOMIA_LOGGING__LEVEL=DEBUG
#   EUNOMIA_OPENMETADATA__MOCK=false
